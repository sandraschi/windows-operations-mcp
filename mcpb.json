{
  "name": "windows-operations-mcp",
  "version": "1.18.1",
  "type": "server",
  "runtime": "python",
  "entry_point": "src/windows_operations_mcp/server.py",
  "dependencies": [
    "fastmcp>=2.14.4,<3.0.0"
  ],
  "build": {
    "include": [
      "src/**/*",
      "README.md",
      "LICENSE",
      "manifest.json",
      "assets/**/*",
      "mcpb/**/*"
    ],
    "exclude": [
      "tests/",
      ".git/",
      "__pycache__/",
      "*.pyc",
      ".venv/",
      "dist/",
      "build/",
      "target/",
      "target_wasm/",
      "coverage_html/",
      "*.mcpb",
      ".pytest_cache/",
      ".coverage",
      "coverage.xml",
      "Cargo.lock"
    ]
  },
  "scripts": {
    "build": "mcpb build",
    "test": "python -m pytest",
    "lint": "ruff check .",
    "format": "ruff format ."
  }
}