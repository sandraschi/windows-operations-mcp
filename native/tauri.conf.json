{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Windows Operations MCP",
	"version": "0.1.0",
	"identifier": "com.sandraschi.windows-operations-mcp",
	"build": {
		"frontendDist": "../web_sota/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Windows Operations MCP Operator",
				"width": 1280,
				"height": 860,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:10748 ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:10748; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/icon.png", "icons/icon.ico"],
		"resources": [
			"resources/winops-mcp-backend.exe",
            "resources/.env.example",
			"../scripts/install-mcp-clients.ps1"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "skip"
			},
			"nsis": {
				"installMode": "currentUser",
				"installerHooks": "./windows/hooks.nsh"
			}
		}
	},
	"plugins": {}
}




