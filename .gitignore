# SOTA v13.1 Infrastructure Core .gitignore
# Purpose: Prevent telemetry and dependency bloat while ensuring structural integrity.

# [VCS/CORE]
.git/
.gitignore
.gitattributes
.gitkeep

# [PYTHON]
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.pytype/
.pyre/
.eslintcache
htmlcov/
.tox/
.nox/
pip-log.txt
pip-delete-this-directory.txt

# [RUST]
target/
Cargo.lock
# Cargo.lock is usually ignored for libraries, but kept for apps.
# This is an MCP server project, which acts as an app.
# However, usually we keep it for reproducibility.

# [NODE / JS / TS]
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.next/
out/
.pnp.*
.yarn/
.cache-loader

# [IDE / OS]
.idea/
.vscode/
*.swp
*.swo
*.iml
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
.cursor/
.history/

# [ENVIRONMENT / SECRETS]
.env
.env.*
!.env.example
*.pem
*.key
*.pub
*-cert.pub

# [LOGS / TEMP]
*.log
*.bak
*.backup
*.tmp
*.temp
out.txt
err.txt
temp/
tmp/

# [PROJECT SPECIFIC]
.snapshots/
_legacy_webapp/
dxt/site-packages/
dxt_package/
!dxt_package/src/
!dxt_package/manifest.json
!dxt_package/requirements.txt
!dxt_package/README.md
!dxt_package/pyproject.toml
!dxt_package/setup.cfg
!dxt_package/setup.py
!dxt_package/MANIFEST.in
extension.wasm
*.dxt
*.pdb

_dashboard/
